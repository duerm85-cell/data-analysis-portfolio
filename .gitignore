# ========== Portfolio 顶层 .gitignore ==========
# 把项目子目录里应该忽略的内容统一在这里 + 子目录的 .gitignore 双重保护

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# 虚拟环境 / conda 环境
.conda/
.venv/
venv/
env/

# 历史归档（项目自身的 archive）
**/archive/

# 用户数据库（含密码哈希，不公开）
**/users.db
**/data/users.db

# IDE
.vscode/
.idea/

# Streamlit
.streamlit/

# 日志
*.log
logs/

# 量化项目生成物（数据、模型和回测结果由流水线本地生成）
projects/01-a-stock-quant-analysis/data/raw/**
!projects/01-a-stock-quant-analysis/data/raw/README.md
projects/01-a-stock-quant-analysis/data/clean/**
!projects/01-a-stock-quant-analysis/data/clean/README.md
projects/01-a-stock-quant-analysis/data/processed/**
!projects/01-a-stock-quant-analysis/data/processed/README.md
projects/01-a-stock-quant-analysis/data/spark_processed/**
projects/01-a-stock-quant-analysis/data/backups/**
projects/01-a-stock-quant-analysis/data/*.db
projects/01-a-stock-quant-analysis/results_optimized/**
!projects/01-a-stock-quant-analysis/results_optimized/README.md
projects/01-a-stock-quant-analysis/backtest_results/**
!projects/01-a-stock-quant-analysis/backtest_results/README.md
projects/01-a-stock-quant-analysis/training_log.json
projects/01-a-stock-quant-analysis/data_cleaning_report.txt
projects/01-a-stock-quant-analysis/reports/**
!projects/01-a-stock-quant-analysis/reports/README.md

# 临时文件
*.tmp
*.bak

# 系统
.DS_Store
Thumbs.db
desktop.ini
